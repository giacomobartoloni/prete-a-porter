# Prete-a-porter — Caddy reverse proxy
# TLS automatico via Let's Encrypt per chat.prete-a-porter.dev
# /ws/* → chat-orchestrator (WebSocket, transitional)
# /*    → openwebui

chat.prete-a-porter.dev {
	# WebSocket → chat-orchestrator (removed once the WS path is retired)
	handle /ws/* {
		reverse_proxy chat-orchestrator:8000
	}

	# Everything else → OpenWebUI
	handle {
		reverse_proxy openwebui:8080
	}
}

# LibreChat — migration candidate, not routed yet.
#
# Activate only once librechat.prete-a-porter.dev resolves to this host: Caddy
# requests a Let's Encrypt certificate for every name it serves, and a name
# without a DNS record fails validation and spends the ACME failure budget.
# Until then, reach LibreChat at http://localhost:3002 on the server (or over an
# SSH tunnel). While active, both UIs answer side by side: OpenWebUI on
# chat.prete-a-porter.dev, LibreChat on librechat.prete-a-porter.dev.
#
# librechat.prete-a-porter.dev {
# 	handle {
# 		reverse_proxy librechat:3080
# 	}
# }
