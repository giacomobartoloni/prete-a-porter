{
  "name": "liturgy-agent",
  "version": "0.1.0",
  "transport": {
    "type": "http",
    "port": 8001,
    "endpoint": "/",
    "message_send_endpoint": "/message:send",
    "authentication": "HTTP Basic Auth on application routes; /health is public"
  },
  "protocol": {
    "type": "jsonrpc",
    "version": "2.0"
  },
  "methods": [
    {
      "name": "agent.ping",
      "description": "Health check endpoint. Returns pong response with agent metadata.",
      "params": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "returns": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "pong",
            "type": "string"
          },
          "agent": {
            "type": "string",
            "const": "liturgy_agent"
          },
          "version": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "status",
          "agent",
          "version"
        ],
        "type": "object"
      },
      "examples": {
        "request": {
          "jsonrpc": "2.0",
          "id": "1",
          "method": "agent.ping",
          "params": {}
        },
        "response": {
          "jsonrpc": "2.0",
          "id": "1",
          "result": {
            "status": "pong",
            "agent": "liturgy_agent",
            "version": "0.1.0"
          }
        }
      }
    },
    {
      "name": "liturgy_agent.get_readings",
      "description": "Get liturgical readings for a specific occasion and optional date. Returns readings from web scraping (for daily mass) or lectionary files (for special occasions).",
      "params": {
        "additionalProperties": false,
        "properties": {
          "occasion": {
            "enum": [
              "sunday",
              "mass",
              "weekday",
              "daily",
              "marriage",
              "baptism",
              "funeral"
            ],
            "type": "string"
          },
          "date": {
            "anyOf": [
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "occasion"
        ],
        "type": "object"
      },
      "returns": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "success",
                "type": "string"
              },
              "data": {
                "additionalProperties": false,
                "properties": {
                  "date": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  "occasion": {
                    "const": "mass",
                    "type": "string"
                  },
                  "metadata": {
                    "additionalProperties": false,
                    "properties": {
                      "date": {
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "type": "string"
                      },
                      "occasion": {
                        "enum": [
                          "mass",
                          "marriage",
                          "baptism",
                          "funeral"
                        ],
                        "type": "string"
                      },
                      "season": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "color": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "year_cycle": {
                        "enum": [
                          "A",
                          "B",
                          "C"
                        ],
                        "type": "string"
                      },
                      "sunday_or_weekday": {
                        "enum": [
                          "Sunday",
                          "Weekday"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "date",
                      "occasion",
                      "season",
                      "color",
                      "year_cycle",
                      "sunday_or_weekday"
                    ],
                    "type": "object"
                  },
                  "first_reading": {
                    "additionalProperties": false,
                    "properties": {
                      "reference": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "text": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "First",
                          "Second",
                          "Gospel",
                          "Psalm",
                          "Alleluia"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "reference",
                      "text",
                      "type"
                    ],
                    "type": "object"
                  },
                  "psalm": {
                    "additionalProperties": false,
                    "properties": {
                      "reference": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "text": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "First",
                          "Second",
                          "Gospel",
                          "Psalm",
                          "Alleluia"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "reference",
                      "text",
                      "type"
                    ],
                    "type": "object"
                  },
                  "second_reading": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "reference": {
                            "pattern": "\\S",
                            "type": "string"
                          },
                          "text": {
                            "pattern": "\\S",
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "First",
                              "Second",
                              "Gospel",
                              "Psalm",
                              "Alleluia"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "reference",
                          "text",
                          "type"
                        ],
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "gospel": {
                    "additionalProperties": false,
                    "properties": {
                      "reference": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "text": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "First",
                          "Second",
                          "Gospel",
                          "Psalm",
                          "Alleluia"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "reference",
                      "text",
                      "type"
                    ],
                    "type": "object"
                  },
                  "alleluia_verse": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "reference": {
                            "pattern": "\\S",
                            "type": "string"
                          },
                          "text": {
                            "pattern": "\\S",
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "First",
                              "Second",
                              "Gospel",
                              "Psalm",
                              "Alleluia"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "reference",
                          "text",
                          "type"
                        ],
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "cached_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "source": {
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "date",
                  "occasion",
                  "metadata",
                  "first_reading",
                  "psalm",
                  "gospel",
                  "cached_at",
                  "source"
                ],
                "type": "object"
              },
              "source": {
                "enum": [
                  "web",
                  "cache"
                ],
                "type": "string"
              }
            },
            "required": [
              "status",
              "data",
              "source"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "success",
                "type": "string"
              },
              "data": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {
                    "occasion_name": {
                      "pattern": "\\S",
                      "type": "string"
                    },
                    "general_readings": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "reference": {
                            "pattern": "\\S",
                            "type": "string"
                          },
                          "text": {
                            "pattern": "\\S",
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "First",
                              "Second",
                              "Gospel",
                              "Psalm",
                              "Alleluia"
                            ],
                            "type": "string"
                          },
                          "id": {
                            "exclusiveMinimum": 0,
                            "type": "integer"
                          },
                          "theme": {
                            "pattern": "\\S",
                            "type": "string"
                          }
                        },
                        "required": [
                          "reference",
                          "text",
                          "type",
                          "id",
                          "theme"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "occasion_name",
                    "general_readings"
                  ],
                  "type": "object"
                },
                "propertyNames": {
                  "enum": [
                    "marriage",
                    "baptism",
                    "funeral"
                  ]
                },
                "type": "object"
              },
              "source": {
                "const": "lectionary",
                "type": "string"
              }
            },
            "required": [
              "status",
              "data",
              "source"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "error",
                "type": "string"
              },
              "error": {
                "pattern": "\\S",
                "type": "string"
              },
              "message": {
                "anyOf": [
                  {
                    "pattern": "\\S",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "status",
              "error"
            ],
            "type": "object"
          }
        ]
      },
      "errors": [
        {
          "code": -32603,
          "message": "Internal error",
          "data": {
            "error_id": "example1"
          },
          "condition": "Custom handler rejects input or fails; details are logged server-side only"
        }
      ],
      "examples": {
        "request_daily_mass": {
          "jsonrpc": "2.0",
          "id": "2",
          "method": "liturgy_agent.get_readings",
          "params": {
            "occasion": "daily",
            "date": "2026-05-19"
          }
        },
        "response_daily_mass": {
          "jsonrpc": "2.0",
          "id": "2",
          "result": {
            "status": "success",
            "data": {
              "date": "2026-05-19",
              "occasion": "mass",
              "metadata": {
                "date": "2026-05-19",
                "occasion": "mass",
                "season": "Ordinary",
                "color": "Green",
                "year_cycle": "A",
                "sunday_or_weekday": "Weekday"
              },
              "first_reading": {
                "reference": "Gc 4,13-17",
                "text": "First reading text.",
                "type": "First"
              },
              "psalm": {
                "reference": "Sal 48",
                "text": "Psalm text.",
                "type": "Psalm"
              },
              "second_reading": null,
              "gospel": {
                "reference": "Mc 9,38-40",
                "text": "Gospel text.",
                "type": "Gospel"
              },
              "alleluia_verse": null,
              "cached_at": "2026-05-19T08:00:00+00:00",
              "source": "evangelizo.org"
            },
            "source": "web"
          }
        },
        "request_marriage": {
          "jsonrpc": "2.0",
          "id": "3",
          "method": "liturgy_agent.get_readings",
          "params": {
            "occasion": "marriage"
          }
        },
        "response_marriage": {
          "jsonrpc": "2.0",
          "id": "3",
          "result": {
            "status": "success",
            "data": {
              "marriage": {
                "occasion_name": "Wedding Ceremony",
                "general_readings": [
                  {
                    "id": 1,
                    "reference": "Mt 19,4-6",
                    "text": "The two shall become one flesh.",
                    "type": "Gospel",
                    "theme": "Unity"
                  }
                ]
              }
            },
            "source": "lectionary"
          }
        },
        "response_upstream_error": {
          "jsonrpc": "2.0",
          "id": "2",
          "result": {
            "status": "error",
            "error": "Fixture upstream unavailable",
            "message": "Could not fetch readings from web sources"
          }
        },
        "response_invalid_params": {
          "jsonrpc": "2.0",
          "id": "2",
          "error": {
            "code": -32603,
            "message": "Internal error",
            "data": {
              "error_id": "example1"
            }
          }
        }
      },
      "semantics": "sunday/mass/weekday/daily return canonical mass with top-level readings. Sunday metadata requires nonblank second reading; weekday second is optional. Ritual data is keyed by marriage/baptism/funeral; upstream failure is status=error."
    },
    {
      "name": "liturgy_agent.get_lectionary",
      "description": "Get lectionary options for a specific occasion. Returns available readings from pre-loaded lectionary files.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "occasion": {
            "enum": [
              "marriage",
              "baptism",
              "funeral"
            ],
            "type": "string"
          }
        },
        "required": [
          "occasion"
        ],
        "type": "object"
      },
      "returns": {
        "additionalProperties": false,
        "properties": {
          "occasion": {
            "enum": [
              "marriage",
              "baptism",
              "funeral"
            ],
            "type": "string"
          },
          "lectionary": {
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "occasion_name": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "general_readings": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "reference": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "text": {
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "First",
                          "Second",
                          "Gospel",
                          "Psalm",
                          "Alleluia"
                        ],
                        "type": "string"
                      },
                      "id": {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      "theme": {
                        "pattern": "\\S",
                        "type": "string"
                      }
                    },
                    "required": [
                      "reference",
                      "text",
                      "type",
                      "id",
                      "theme"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "occasion_name",
                "general_readings"
              ],
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "marriage",
                "baptism",
                "funeral"
              ]
            },
            "type": "object"
          },
          "readings_count": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "occasion",
          "lectionary",
          "readings_count"
        ],
        "type": "object"
      },
      "errors": [
        {
          "code": -32603,
          "message": "Internal error",
          "data": {
            "error_id": "example1"
          },
          "condition": "Custom handler rejects input or fails; details are logged server-side only"
        }
      ],
      "examples": {
        "request": {
          "jsonrpc": "2.0",
          "id": "4",
          "method": "liturgy_agent.get_lectionary",
          "params": {
            "occasion": "marriage"
          }
        },
        "response_success": {
          "jsonrpc": "2.0",
          "id": "4",
          "result": {
            "occasion": "marriage",
            "lectionary": {
              "marriage": {
                "occasion_name": "Wedding Ceremony",
                "general_readings": [
                  {
                    "id": 1,
                    "reference": "Mt 19,4-6",
                    "text": "The two shall become one flesh.",
                    "type": "Gospel",
                    "theme": "Unity"
                  }
                ]
              }
            },
            "readings_count": 1
          }
        },
        "response_error": {
          "jsonrpc": "2.0",
          "id": "4",
          "error": {
            "code": -32603,
            "message": "Internal error",
            "data": {
              "error_id": "example1"
            }
          }
        }
      }
    }
  ],
  "error_codes": {
    "-32603": "Internal error; sanitized custom-handler failure with data.error_id"
  },
  "error_semantics": {
    "custom_root": "Custom method exceptions (unknown method, invalid/missing parameters, unexpected failures) return -32603 Internal error with data.error_id. Typed -32601/-32602 mapping is deferred.",
    "message_send": "Handler exceptions inside message/send become sanitized error text in the agent reply, not a JSON-RPC error envelope.",
    "built_in_routes": "Task routing has separate behavior; this contract does not promise custom-handler -32601/-32602 or domain-specific codes."
  }
}
