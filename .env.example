# ──────────────────────────────────────────────
# LLM — Provider Selection
# ──────────────────────────────────────────────
# La factory usa il PRIMO provider con API key settata, in quest'ordine:
#   1. Anthropic (ANTHROPIC_API_KEY)
#   2. Google    (GOOGLE_API_KEY)
#   3. OpenAI    (OPENAI_API_KEY)
#
# Imposta UNA SOLA chiave alla volta per controllare quale provider usare.

# ── Anthropic (Claude) ─────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Google (Gemini) ────────────────────────────
# https://aistudio.google.com/app/apikey
# Google NON supporta base_url custom.
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-flash-lite-latest

# ── OpenAI / Compatibili (OpenAI, Fireworks, Groq, Together, Ollama, vLLM) ──
# https://platform.openai.com/api-keys
# Per provider OpenAI-compatibili, cambia BASE_URL e MODEL_NAME.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4-turbo-preview
OPENAI_BASE_URL=https://api.openai.com/v1

#   Esempio: Fireworks AI
#   OPENAI_API_KEY=fw_3aBcDeFgHiJkLmNoPqRsTuVwXyZ
#   OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#   OPENAI_MODEL_NAME=accounts/fireworks/models/llama-v3p1-70b-instruct

#   Esempio: Groq
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL_NAME=llama-3.3-70b-versatile

#   Esempio: Ollama (locale)
#   OPENAI_API_KEY=ollama          # Ollama ignora la key, ma va settata
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL_NAME=llama3.2

# WebSocket JWT Secret (condiviso tra frontend e chat-orchestrator)
# Genera con: openssl rand -hex 16
WS_JWT_SECRET=change-this-secret

# NextAuth Secret (usato per firmare i JWT di sessione)
# Genera con: openssl rand -hex 32
AUTH_SECRET=change-this-secret

# ──────────────────────────────────────────────
# Deployment — Produzione con Caddy reverse proxy
# ──────────────────────────────────────────────
# Locale: lasciare vuoto (default ws://chat-orchestrator:8000/ws/chat)
# Produzione: URL pubblico wss:// raggiungibile dal browser via Caddy
WS_URL=

# CORS — origin permesse per il chat-orchestrator (comma-separated)
# Locale: http://localhost:3000 (default)
# Produzione: https://chat.prete-a-porter.dev
CORS_ORIGINS=

# A2A Basic Auth for inter-agent HTTP (both values required; partial pairs fail closed)
# Opt-in unauthenticated development only: A2A_ALLOW_UNAUTHENTICATED=true (still rejects partial pairs)
A2A_BASIC_AUTH_USERNAME=a2a
A2A_BASIC_AUTH_PASSWORD=change-this-secret
# A2A_ALLOW_UNAUTHENTICATED=false

# ──────────────────────────────────────────────
# OpenAI-compatible API (OpenWebUI integration)
# ──────────────────────────────────────────────
# Bearer key required by every /v1/* route on the chat-orchestrator.
# Generate with: openssl rand -hex 32
# NOTE: do not name this OPENAI_API_KEY — that variable is the upstream LLM
# provider key and reusing it would break provider selection.
ORCHESTRATOR_API_KEY=change-this-secret

# Rate Limiting (per-user sliding window)
RATE_LIMIT_MESSAGES_PER_HOUR=5
RATE_LIMIT_MESSAGES_PER_DAY=20
RATE_LIMIT_DB_PATH=/app/data/rate_limiter.db

# Wall-clock bound for one /v1/chat/completions request, in seconds. Covers the
# buffered completion, the streamed completion, and utility-task LLM calls.
# Without it a stuck downstream agent holds the request open forever. A value
# that is not a positive number makes the orchestrator fail loudly.
CHAT_REQUEST_TIMEOUT_SECONDS=180

# ──────────────────────────────────────────────
# OpenWebUI (chat frontend)
# ──────────────────────────────────────────────
# The orchestrator's /v1/* API is exposed to OpenWebUI as a model.
# OpenWebUI sends ORCHESTRATOR_API_KEY as its bearer token.
#
# Per-connection custom header (already set in docker-compose.yml; configure it
# manually in Admin > Settings > Connections > Headers if you run OpenWebUI
# outside Compose):
#   {"X-OpenWebUI-Chat-Id": "{{CHAT_ID}}"}
#
# ENABLE_FORWARD_USER_INFO_HEADERS=True makes OpenWebUI send X-OpenWebUI-User-Id,
# which the orchestrator uses as the per-user rate-limit key. Without it every
# user shares one quota bucket.
#
# Prefer a dedicated task model over disabling the auxiliary tasks when a second
# model is available; see packages/chat-orchestrator/README.md.

# OpenWebUI session signing. Generate with: openssl rand -hex 32
# Required by the openwebui service in docker-compose.yml.
WEBUI_SECRET_KEY=change-this-secret

# ──────────────────────────────────────────────
# LibreChat (optional OpenAI-compatible chat shell)
# ──────────────────────────────────────────────
# Started with the overlay:
#   docker compose -f docker-compose.yml -f deploy/librechat/docker-compose.librechat.yml up -d
#
# LibreChat is a client of the same /v1/* surface; OpenWebUI keeps working
# unchanged. It reuses ORCHESTRATOR_API_KEY as its server-side bearer
# credential and reaches the orchestrator at PRETE_API_BASE_URL.
PRETE_API_BASE_URL=http://chat-orchestrator:8000/v1

# Pinned LibreChat release. Bump only after re-validating
# deploy/librechat/librechat.yaml against the new release's config schema.
LIBRECHAT_IMAGE_TAG=v0.8.7

# LibreChat secrets — all four are required. Generate with:
#   openssl rand -hex 32   # JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY
#   openssl rand -hex 16   # CREDS_IV
LIBRECHAT_JWT_SECRET=change-this-secret
LIBRECHAT_JWT_REFRESH_SECRET=change-this-secret
LIBRECHAT_CREDS_KEY=change-this-secret
LIBRECHAT_CREDS_IV=change-this-secret

# Public URL LibreChat advertises to the browser (cookies, redirects, links).
# Leave empty for the local default http://localhost:3002.
# Production: https://librechat.prete-a-porter.dev
LIBRECHAT_DOMAIN_CLIENT=
LIBRECHAT_DOMAIN_SERVER=

# Registration stays open until the pilot accounts exist; set to false after.
LIBRECHAT_ALLOW_REGISTRATION=true

# ──────────────────────────────────────────────
# Chainlit native UI (prete-chat + prete-chat-db)
# ──────────────────────────────────────────────
# Started with the overlay:
#   docker compose -f docker-compose.yml -f deploy/chainlit/docker-compose.chainlit.yml up -d
#
# The native UI imports the chat core in-process and owns its own users and
# conversation history in a dedicated PostgreSQL database (not the legacy
# frontend's SQLite file). See deploy/chainlit/README.md.
#
# Signs the Chainlit session cookie. Required whenever persistence is enabled
# (a postgresql+asyncpg DATABASE_URL); rotating it logs everyone out.
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=change-this-secret

# Public URL of the native UI (cookies, redirects). Local default in the
# overlay; production: https://app.prete-a-porter.dev
CHAINLIT_URL=http://localhost:3003

# Password of the `chainlit` PostgreSQL role and database, created on first
# boot of prete-chat-db. Generate with: openssl rand -hex 24
PRETE_CHAT_DB_PASSWORD=change-this-secret

# ──────────────────────────────────────────────
# Container images (GHCR) — deploy from registry
# ──────────────────────────────────────────────
# Tag for all prebuilt service images (single version covers all services).
# Local dev: leave 'latest'; build from source with `docker compose up --build`.
# Production: set to a release tag (e.g. 1.0.0) or a sha tag (e.g. sha-dc651c8).
IMAGE_TAG=latest

# When to pull images: missing (default, pull only if absent) | always | never
# Production: 'always' ensures latest on every `up`; or run `docker compose pull` first.
PULL_POLICY=missing
